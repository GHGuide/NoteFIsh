# Copy to .env. Never paste keys into the website or commit .env.
HOST=127.0.0.1
PORT=3001
# Render sets PORT automatically; use HOST=0.0.0.0 and DATA_DIR=/var/data there.
DATA_DIR=
# Required before opening the desk through an HTTPS tunnel. At least 16 characters.
# HTTP Basic username is: desk
NOTEFISH_DESK_PASSWORD=
PUBLIC_BASE_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPENAI_API_KEY=
FISH_API_KEY=

FISH_MODEL=s2.1-pro-free
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
