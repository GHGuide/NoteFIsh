# Copy to .env. Never paste keys into the website or commit .env.
HOST=127.0.0.1
PORT=3001
# Render sets PORT automatically; use HOST=0.0.0.0 and DATA_DIR=/var/data there.
DATA_DIR=
# Required before opening the desk through an HTTPS tunnel. At least 16 characters.
# HTTP Basic username is: desk
NOTEFISH_DESK_PASSWORD=
# Source defaults to protected access. Explicit true opens one shared workspace.
# The temporary Render demo image opts in; false restores its existing login.
NOTEFISH_PUBLIC_DEMO=false
PUBLIC_BASE_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPENAI_API_KEY=
FISH_API_KEY=
# Optional. Set it and every voice recorded from then on is enrolled at ElevenLabs
# as well, and speech falls back there when Fish cannot speak. Leave it empty and
# Fish failing is simply a failure.
ELEVENLABS_API_KEY=
# Optional. A postgres:// connection string, for example from Supabase. With it the
# desk keeps its data in that database instead of a file, and the existing file is
# moved across the first time it starts.
DATABASE_URL=

# s2.1-pro-free is free until 30 Nov 2026 and its requests may be kept for training.
# Move to s2.1-pro before any real customer audio goes through it.
FISH_MODEL=s2.1-pro-free
# How long Fish buffers before the first chunk: low, balanced or normal.
FISH_LATENCY=balanced
# The finished-clip model, and the one that streams words as the caller talks.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# Floor. Seats are presence, not authentication: anyone with workspace access
# can take any roster name. Multi-agent needs NOTEFISH_PUBLIC_DEMO=false.
# Without a session secret, seats last only as long as the process. 32+ chars.
NOTEFISH_SESSION_SECRET=
NOTEFISH_MAX_AGENTS=20
NOTEFISH_MAX_CONCURRENT_CALLS=20

# Outbound only: a completed call leaves as a ticket elsewhere. All optional.
# Receivers verify sha256=HMAC(secret, "<timestamp>.<raw body>"). 32+ chars.
NOTEFISH_WEBHOOK_URL=
NOTEFISH_WEBHOOK_SECRET=
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
# Bearer token for the read-only pull API at /api/export/calls. 32+ chars.
NOTEFISH_EXPORT_TOKEN=
