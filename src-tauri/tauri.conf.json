{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteFIsh",
  "version": "0.1.0",
  "identifier": "com.notefish.desk",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:3001",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "NoteFIsh",
        "url": "http://127.0.0.1:3001/desk",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "entitlements.plist"
    }
  }
}
